+// EDEN_GOV_TEX_TRIM_MIB=<MiB> (off unless set; OOT-PS5 memory design, phase 1): the same trim, made
+// only while the pool governor (src/direct_memory.c) is at yellow or worse (the pool's largest free
+// block under EDEN_GOV_YELLOW_MIB), and for single textures too (EDEN_GOV_TEX_TRIM_LAYERS, default
+// 1): degrade a new large texture by one level instead of failing it, while memory is short. Images
+// made while the pool has room keep every level. It is decided once for each image: TrimmedHostInfo
+// is asked several times while one image is made (its allocation, a backing after an unbacked one,
+// its sparse layers), and the answers must agree. The first question on a thread takes the latch,
+// and Image::Image lets it go when that image is made.
+extern "C" int eden_governor_level(void) __attribute__((weak));
+thread_local int governor_trim_latch = -1;
+[[nodiscard]] u64 GovernorTrimLimit() {
+    static const u64 limit = [] {
+        const char* value = std::getenv("EDEN_GOV_TEX_TRIM_MIB");
+        return value != nullptr ? std::strtoull(value, nullptr, 10) << 20 : 0ULL;
+    }();
+    return limit;
+}
+[[nodiscard]] u32 GovernorTrimLayers() {
+    static const u32 layers = [] {
+        const char* value = std::getenv("EDEN_GOV_TEX_TRIM_LAYERS");
+        return value != nullptr ? (std::max)(static_cast<u32>(std::strtoul(value, nullptr, 10)), 1U) : 1U;
+    }();
+    return layers;
+}
+[[nodiscard]] bool GovernorTrimNow() {
+    if (GovernorTrimLimit() == 0 || eden_governor_level == nullptr) {
+        return false;
+    }
+    if (governor_trim_latch < 0) {
+        governor_trim_latch = eden_governor_level() >= 1 ? 1 : 0;
+    }
+    return governor_trim_latch == 1;
+}
