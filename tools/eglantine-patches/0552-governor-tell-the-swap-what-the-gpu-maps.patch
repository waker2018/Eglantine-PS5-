+// EDEN_GOV_SWAP_CPU_ONLY=1 (OOT-PS5 memory design, phase 4; src/guest_memory_service.inc): the guest
+// memory the GPU's page table maps is never swapped out. Weak: absent where the frontend has no swap.
+extern "C" void eden_guest_gpu_map(const void* host, std::size_t bytes, int delta) noexcept __attribute__((weak));
+
 namespace Tegra {
+
+namespace {
+// The host memory behind [dev_addr, dev_addr + size), 2 MiB at a time (the swap's slot), told to the
+// guest memory service as mapped (delta 1) or unmapped (-1).
+template <typename DeviceMemory>
+void TellGuestGpuMap(DeviceMemory& memory, DAddr dev_addr, std::size_t size, int delta) {
+    constexpr std::size_t Step = std::size_t{2} << 20;
+    for (std::size_t done = 0; done < size;) {
+        const DAddr at = dev_addr + done;
+        const std::size_t step = (std::min)(size - done, Step - static_cast<std::size_t>(at % Step));
+        eden_guest_gpu_map(memory.template GetPointer<u8>(at), step, delta);
+        done += step;
+    }
+}
+} // namespace
 bool MemoryManager::IsShuttingDown() const {
     return system.IsShuttingDown();
 }
